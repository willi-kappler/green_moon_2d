project(
  'green_moon_2d',
  'cpp',
  version: '0.0.1',
  default_options: ['cpp_std=c++23', 'warning_level=3', 'buildtype=release']
)



# Define custom warning or optimization flags
# TODO: copy from xmake.lua
extra_flags = [
  '-Wshadow',
  '-Wnon-virtual-dtor',
  '-Wold-style-cast',
  '-Wcast-align',
  '-Wunused',
  '-Wconversion',
  '-Wsign-conversion'
]

# Safely check which flags are supported by the active compiler
# supported_flags = cpp_compiler.get_supported_arguments(extra_flags)

# Pass them globally to all targets...
# add_project_arguments(supported_flags, language: 'cpp')



# Import the CMake module
cmake = import('cmake')

# Point the include directory to 'src'
inc_dir = include_directories('src/gm2d')

# Source files
sources = files(
  'src/gm2d/gm2d.cpp',
  'src/gm2d/gm_animation.cpp',
  'src/gm2d/gm_bitmapfont.cpp',
  'src/gm2d/gm_bitmaptext.cpp',
  'src/gm2d/gm_configuration.cpp',
  'src/gm2d/gm_context.cpp',
  'src/gm2d/gm_math.cpp',
  'src/gm2d/gm_message.cpp',
  'src/gm2d/gm_object.cpp',
  'src/gm2d/gm_resources.cpp',
  'src/gm2d/gm_scene.cpp',
  'src/gm2d/gm_sprite.cpp',
  'src/gm2d/gm_texture.cpp',
  'src/gm2d/gm_timer.cpp'
)

# External dependencies:

# Configure taocpp-json as a CMake subproject
tao_json_sub = cmake.subproject('taocpp-json')
# Get the dependency target generated by CMake
tao_json_dep = tao_json_sub.dependency('taocpp-json')

# SDL3:
sdl3_dep = dependency('sdl3', fallback: ['sdl3', 'sdl3_dep'])
sdl3_image_dep = dependency('sdl3_image', fallback: ['sdl3_image', 'sdl3_image_dep'])

# For unit testing:
snitch_dep = dependency('snitch', fallback: ['snitch', 'snitch_dep'])

# Build the library
lib = shared_library(
  'green_moon_2d',
  sources,
  include_directories: inc_dir,
  dependencies: [
    tao_json_dep,
    sdl3_dep,
    sdl3_image_dep
  ],
  override_options: ['werror=true'],
  #cpp_args: supported_flags,
  install: true
)

# Declare dependency for other targets/projects
green_moon_2d_dep = declare_dependency(
  include_directories: inc_dir,
  link_with: lib
)

# Explicitly list header files to install them to system paths
install_headers(
  'src/gm2d/gm2d.hpp'
)

# Unit test configuration
test_exe = executable(
  'lib_tests',
  'tests/test_all.cpp',
  dependencies: [
    green_moon_2d_dep,
    snitch_dep
  ],
  override_options: ['werror=true']
)

test('unit tests', test_exe)
